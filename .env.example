# PostgreSQL for running the API directly on your computer.
# Docker Compose overrides DATABASE_URL to use the internal host "db".
DATABASE_URL=postgresql+asyncpg://app:change-me-in-production@localhost:5432/requests_db

POSTGRES_DB=requests_db
POSTGRES_USER=app
# Use a strong URL-safe password (letters/numbers/_/-) for this starter setup.
POSTGRES_PASSWORD=change-me-in-production

# Leave both values empty to run without Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# JSON array of exact frontend origins; include scheme and port, but no path.
# '*' is rejected. After changing it, recreate the api container (restart does not reload .env).
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
APP_ENV=development
LOG_LEVEL=INFO
NOTIFICATION_POLL_INTERVAL_SECONDS=3
NOTIFICATION_RETRY_MAX_SECONDS=3600

# Visit statistics: calendar periods use this time zone; visits older than the retention are deleted.
STATS_TIMEZONE=Europe/Moscow
VISITS_RETENTION_MONTHS=12
# Max POST /api/v1/visits per minute per visitor (in memory, single API process).
VISITS_RATE_LIMIT_PER_MINUTE=30
# Answer /visits, /sources and /help in TELEGRAM_CHAT_ID (needs the Telegram values above).
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_POLL_TIMEOUT_SECONDS=25
